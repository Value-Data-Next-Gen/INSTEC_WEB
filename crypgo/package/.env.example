# URL de la aplicación de gestión INSTEC (portal de clientes / app de órdenes,
# informes/CIT y pagos). Los botones "Iniciar sesión" y "Acceder al portal"
# del sitio corporativo apuntan a esta URL.
#
# Si no se define, se usa el valor por defecto: https://app.instec.cl
NEXT_PUBLIC_APP_URL=https://app.instec.cl

# ID de Google Analytics 4 (formato G-XXXXXXXXXX).
# Si no se define, no se carga ningún script de analítica (los eventos son no-op).
NEXT_PUBLIC_GA_ID=
